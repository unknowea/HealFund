{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "1. Start Backend API Server (Port 5000)",
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "2. Start Main Patient Portal (Port 3000)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "3000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "3. Start Dedicated Admin Portal (Port 3001)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "3001"],
      "cwd": "${workspaceFolder}/frontend-admin",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Launch Full HealFund Suite (Backend + Patient + Admin)",
      "configurations": [
        "1. Start Backend API Server (Port 5000)",
        "2. Start Main Patient Portal (Port 3000)",
        "3. Start Dedicated Admin Portal (Port 3001)"
      ]
    }
  ]
}
