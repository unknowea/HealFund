{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Run All Dev Servers (Backend + User + Admin)",
      "command": "npm run dev",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Start Backend Server (Port 5000)",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Start User Frontend (Port 3000)",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/user frontend"
      },
      "problemMatcher": []
    },
    {
      "type": "shell",
      "label": "Start Admin Frontend (Port 3001)",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/admin frontend"
      },
      "problemMatcher": []
    }
  ]
}
